<?xml version="1.0"?>
<package format="2"> <!-- (ros1용) -->
  <name>lidar_lane</name>
  <version>0.0.0</version>
  <description>LiDAR lane detection package</description>

  <maintainer email="judy293@koreatech.ac.kr">김예진</maintainer> <!-- (ros1용) -->
  <license>MIT</license> <!-- (ros1용, 필요시 수정) -->

  <!-- buildtool_depend: catkin -->
  <buildtool_depend>catkin</buildtool_depend> <!-- (ros1용) -->

  <!-- dependencies -->
  <depend>roscpp</depend> <!-- (ros1용: rclcpp → roscpp) -->
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>pcl_conversions</depend>

  <!-- OpenCV는 system package로 찾기 때문에 보통 package.xml에 안 넣어도 됨 -->
  
  <export>
    <!-- build_type은 catkin이 기본이라 생략 가능 -->
  </export>
</package>